# =========================

# ── Python ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Virtual Environment ──────────────────
venv/
.venv/
env/
ENV/

# ── Environment Variables (SECRETS) ──────
.env
.env.*
!.env.example

# ── AWS & Credentials ────────────────────
.aws/
aws-exports.js
serverless.yml.bak
samconfig.toml

# ── LINE API Secrets ──────────────────────
line_secret.json
channel_secret.txt

# ── IDE / Editor ─────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Testing & Coverage ────────────────────
.pytest_cache/
.coverage
htmlcov/
*.xml

# ── Logs ─────────────────────────────────
*.log
logs/

# ── Lambda Deployment Package ────────────
*.zip
package/
